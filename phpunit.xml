<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Filament">
            <directory>tests/Filament</directory>
        </testsuite>
        <testsuite name="Platform">
            <directory>tests/Platform</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PENNANT_STORE" value="array"/>

        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="LOG_CHANNEL" value="null"/>
        <env name="BUGSNAG_API_KEY" value=""/>
        <env name="DISCORD_WEBHOOK_USER_UPDATES" value=""/>
        <env name="DISCORD_WEBHOOK_OTHER_UPDATES" value=""/>
        <env name="SPOTIFY_CLIENT_ID" value="spotify-test-client-id"/>
        <env name="SPOTIFY_CLIENT_SECRET" value="spotify-test-client-secret"/>
        <env name="STRIPE_KEY" value="pk_test_songrank"/>
        <env name="STRIPE_SECRET" value="sk_test_songrank"/>
        <env name="STRIPE_WEBHOOK_SECRET" value="whsec_test_songrank"/>
        <env name="STRIPE_PRICE_SONG_RANK_PRO_ID" value="price_test_songrank"/>
        <env name="STRIPE_AUTOMATIC_TAX" value="false"/>
    </php>
</phpunit>
