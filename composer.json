{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.4||^8.5",
        "blaspsoft/blasp": "^4.0",
        "bugsnag/bugsnag-laravel": "^2.27",
        "doctrine/dbal": "^4.0",
        "filament/filament": "~5.0",
        "flowframe/laravel-trend": "^0.5.0",
        "guzzlehttp/guzzle": "^7.8",
        "kyledoesdev/essentials": "^0.0.9",
        "laravel/cashier": "^16.8",
        "laravel/framework": "^13.0",
        "laravel/head": "^0.2.2",
        "laravel/nightwatch": "^1.7",
        "laravel/pennant": "^1.26",
        "laravel/socialite": "^5.11",
        "laravel/tinker": "^3.0",
        "maatwebsite/excel": "4.x-dev",
        "marvinlabs/laravel-discord-logger": "^1.4",
        "socialiteproviders/spotify": "^4.1",
        "spatie/filament-simple-stats": "^1.1",
        "spatie/laravel-comments": "^2.3.1",
        "spatie/laravel-comments-livewire": "^4.2",
        "spatie/laravel-health": "^1.34",
        "spatie/laravel-stats": "^2.3",
        "spatie/laravel-support-bubble": "^1.9"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.23",
        "filament/upgrade": "^5.0",
        "glhd/laravel-dumper": "^3.0",
        "laravel/boost": "^2.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-browser": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "spatie/laravel-ignition": "^2.4"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://satis.spatie.be"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/global/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
