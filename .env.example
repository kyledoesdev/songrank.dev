APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://song-rank.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=song_ranker
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Pin in production to keep the pre-Laravel 13 cookie name. Laravel 13 changed
# the default to Str::snake(APP_NAME); leaving this UNSET uses that default,
# but leaving it EMPTY sets an empty cookie name and breaks every request.
# SESSION_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@songrank.dev"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Spotify OAuth (required)
# --------------------------------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard, then add the full
# callback URL (APP_URL + SPOTIFY_REDIRECT_URI) to its allowed redirect URIs.
# SYSTEM_SPOTIFY_ID is the Spotify user id treated as the app owner.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI="/login/spotify/callback"
SYSTEM_SPOTIFY_ID=

# --------------------------------------------------------------------------
# Support & health (optional locally)
# --------------------------------------------------------------------------
# HELP_EMAIL receives messages from the in-app support bubble.
# FAILURE_EMAIL receives health-check failure notifications.
# HEALTH_SECRET_TOKEN guards the /health endpoint when set.

HELP_EMAIL=
FAILURE_EMAIL="kyle@example.com"
HEALTH_SECRET_TOKEN=

# --------------------------------------------------------------------------
# Error tracking & logging (optional locally)
# --------------------------------------------------------------------------
# Leave BUGSNAG_API_KEY empty to disable error reporting.
# The Discord webhooks back the "user updates" and "other updates" log
# channels in config/logging.php; unset channels simply do not send.

BUGSNAG_API_KEY=

DISCORD_WEBHOOK_USER_UPDATES=
DISCORD_WEBHOOK_OTHER_UPDATES=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SONG_RANK_PRO_ID=
STRIPE_AUTOMATIC_TAX=false
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en
